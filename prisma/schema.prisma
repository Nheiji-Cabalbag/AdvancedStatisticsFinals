generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"] // rhel-... is the runtime Vercel uses
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection, used by the app
  directUrl = env("DIRECT_URL")   // direct connection, used by prisma migrate
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  tokenVersion Int      @default(0) // bumped on password change to sign out old sessions
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Serverless functions do not share memory, so rate limits live in the database.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}
