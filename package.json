{
  "name": "advstat-system",
  "version": "3.0.0",
  "private": true,
  "description": "ADVSTAT final project: regression and Z testing workbench with accounts (Vite, Vercel functions, Prisma, Postgres)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:server\" \"vite\"",
    "server": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsx src/stats.test.ts",
    "typecheck:api": "tsc -p tsconfig.server.json",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@vercel/node": "^3.2.0",
    "concurrently": "^9.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "prisma": "5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
