{
  "name": "advstat-system",
  "version": "2.0.0",
  "private": true,
  "description": "ADVSTAT final project: regression and Z testing workbench with accounts (TypeScript, Vite, Express, Prisma)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:server\" \"vite\"",
    "server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsx src/stats.test.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "concurrently": "^9.0.0",
    "prisma": "5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
